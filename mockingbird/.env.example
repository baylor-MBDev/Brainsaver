# Copy to .env (`mb init` does it) and fill in what you use. Never commit .env.
# Every key is optional; `mb doctor` shows what each one unlocks.

# Claude: writes outreach sequences, demo-site copy, and blog posts.
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Defaults to the model in mockingbird.config.js (claude-opus-5-5).
MB_MODEL=

# Apollo.io: company search (1 credit / 100 results) and email reveals
# (1 credit each, only for leads that qualify). Enable these endpoints on the
# key: mixed_companies/search, mixed_people/api_search, people/bulk_match.
APOLLO_API_KEY=

# Google Cloud: enable "Places API (New)" and "PageSpeed Insights API".
GOOGLE_PLACES_API_KEY=
PAGESPEED_API_KEY=

# Cold email sending tool (pick one). Optional: you can upload CSVs instead.
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=

# Cloudflare: deploying the website and prospect demo sites from your machine.
# Token template: "Edit Cloudflare Workers" (+ D1 edit for migrations).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Where lead data lives (default: mockingbird/data). Keep it out of git.
MB_DATA_DIR=
