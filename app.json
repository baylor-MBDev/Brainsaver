{
  "expo": {
    "name": "DOOMTYPE",
    "slug": "doomtype",
    "version": "1.4.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EFEBFF",
    "splash": {
      "backgroundColor": "#221C3A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.mockingbird.doomtype",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "DOOMTYPE uses the camera to count your pushups. Video is analyzed on your phone and never saved or sent anywhere.",
        "NSMotionUsageDescription": "DOOMTYPE reads your step count so a walk can earn you screen time.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.mockingbird.doomtype",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFEBFF"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-font",
      "./plugins/withReleaseSigning.js",
      [
        "react-native-device-activity",
        {
          "appGroup": "group.dev.mockingbird.doomtype"
        }
      ]
    ]
  }
}
